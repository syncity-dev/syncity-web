# Copy to .env.local and fill in what you need. Every variable is optional for `pnpm dev`.

# `true` publishes draft posts and adds `noindex` to every page. Only the develop deploy
# (develop.syncity.dev) sets it, so drafts can be reviewed there.
VITE_SHOW_DRAFTS=false

# Formspree form ID for the contact form. Without it the form can't send.
VITE_CONTACT_FORM_ID=

# Cloudflare Turnstile site key for the contact form. Without it the always-pass test key is used.
VITE_TURNSTILE_SITE_KEY=
